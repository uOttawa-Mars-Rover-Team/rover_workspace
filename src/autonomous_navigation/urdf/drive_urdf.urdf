<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

    <xacro:include filename="gazebo_gps.xacro" />
    <xacro:include filename="gazebo_imu.xacro" />
    <xacro:include filename="gazebo_2D_lidar.xacro" />
    <xacro:include filename="ros2_control.xacro" />
    <xacro:include filename="inertial_macros.xacro" />

    <xacro:property name="chassis_mass" value="20.0" />
    <xacro:property name="wheel_mass" value="7.5" />
    <xacro:property name="wheel_offset_x" value="0.38" />
    <xacro:property name="wheel_offset_z" value="0.198" />
    <xacro:property name="wheel_radius" value="0.20" />
    <xacro:property name="wheel_thickness" value="0.175" />

    <xacro:property name="wheel_mu" value="0.5" />
    <xacro:property name="wheel_fdir1" value="1 0 0" />
    <xacro:property name="wheel_kp" value="1000000000000.0" />
    <xacro:property name="wheel_kd" value="100.0" />

    <link name="base_footprint">
        <!-- base_footprint doesn't require inertial attributes but keeping for reference -->
        <!-- <inertial>
            <origin xyz="0.0045313 -0.00073022 2.7991E-06" rpy="0 0 0" />
            <mass value="1E-12" />
            <inertia
                ixx="1.6667E-23"
                ixy="0"
                ixz="-5.0154E-40"
                iyy="1.6667E-23"
                iyz="-1.0896E-50"
                izz="1.6667E-23" />
        </inertial> -->
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://autonomous_navigation/meshes/visual/base_footprint.STL" />
            </geometry>
            <material name="">
                <color rgba="0.79216 0.81961 0.93333 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://autonomous_navigation/meshes/visual/base_footprint.STL" />
            </geometry>
        </collision>
    </link>

    <link name="base_link">
        <!-- <inertial>
            <origin xyz="-0.018756 0.0030187 0.29298" rpy="0 0 0" />
            <mass value="20" />
            <inertia
                ixx="0.08369"
                ixy="0.00027047"
                ixz="-7.4838E-05"
                iyy="0.096132"
                iyz="-3.3912E-05"
                izz="0.15542" />
        </inertial> -->
        <xacro:inertial_box mass="${chassis_mass}" x="1" y="0.57" z="0.25">
            <origin xyz="0 0 0.3" rpy="0 0 0" />
        </xacro:inertial_box>
        <visual>
            <origin xyz="0 0 0.3" rpy="0 0 0" />
            <geometry>
                <box size="1 0.57 0.25" />
            </geometry>
            <!-- <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://autonomous_navigation/meshes/visual/base_link.STL" />
            </geometry> -->
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.3" rpy="0 0 0" />
            <geometry>
                <box size="1 0.57 0.25" />
            </geometry>
            <!-- <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://autonomous_navigation/meshes/visual/base_link.STL" />
            </geometry> -->
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="base_footprint" />
        <axis xyz="0 0 0" />
    </joint>

    <link name="FL_wheel">
        <!-- <inertial>
            <origin xyz="0.00039914 -0.00040979 -0.00052985" rpy="0 0 0" />
            <mass value="7.5" />
            <inertia
                ixx="0.24161"
                ixy="3.9685E-06"
                ixz="-7.2069E-09"
                iyy="0.24162"
                iyz="-2.4995E-08"
                izz="0.40243" />
        </inertial> -->
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}"
            radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
            </geometry>
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="q1" type="continuous">
        <origin xyz="0.414 ${wheel_offset_x} ${wheel_offset_z}" rpy="1.5708 0 0" />
        <parent link="base_link" />
        <child link="FL_wheel" />
        <axis xyz="0 0 -1" />
        <limit
            lower="0"
            upper="0"
            effort="0"
            velocity="0" />
    </joint>

    <link name="FR_wheel">
        <!-- <inertial>
            <origin xyz="0.00053061 8.5616E-05 0.00052985" rpy="0 0 0" />
            <mass value="7.5" />
            <inertia
                ixx="0.24161"
                ixy="3.8671E-06"
                ixz="-6.752E-09"
                iyy="0.24162"
                iyz="-2.5122E-08"
                izz="0.40243" />
        </inertial> -->
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}"
            radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
            </geometry>
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="q2" type="continuous">
        <origin xyz="0.414 ${-wheel_offset_x} ${wheel_offset_z}" rpy="1.5708 0 0" />
        <parent link="base_link" />
        <child link="FR_wheel" />
        <axis xyz="0 0 -1" />
    </joint>

    <link name="RR_wheel">
        <!-- <inertial>
            <origin xyz="-0.00038558 -0.00027142 0.00052985" rpy="0 0 0" />
            <mass value="7.5" />
            <inertia
                ixx="0.24161"
                ixy="-3.8406E-06"
                ixz="6.9605E-09"
                iyy="0.24162"
                iyz="-2.5065E-08"
                izz="0.40243" />
        </inertial> -->
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}"
            radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
            </geometry>
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="q3" type="continuous">
        <origin xyz="-0.405 ${-wheel_offset_x} ${wheel_offset_z}" rpy="1.5708 0 0" />
        <parent link="base_link" />
        <child link="RR_wheel" />
        <axis xyz="0 0 -1" />
    </joint>

    <link name="RL_wheel">
        <!-- <inertial>
            <origin xyz="2.8197E-07 2.7432E-07 -0.00052985" rpy="0 0 0" />
            <mass value="7.5" />
            <inertia
                ixx="0.24162"
                ixy="7.576E-06"
                ixz="-1.8739E-08"
                iyy="0.24162"
                iyz="-1.8043E-08"
                izz="0.40243" />
        </inertial> -->
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}"
            radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}" />
            </geometry>
            <material name="">
                <color rgba="0.75294 0.75294 0.75294 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <!-- <mesh filename="package://autonomous_navigation/meshes/visual/FL_wheel.STL" /> -->
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
    </link>

    <joint name="q4" type="continuous">
        <origin xyz="-0.405 ${wheel_offset_x} ${wheel_offset_z}" rpy="1.5708 0 0" />
        <parent link="base_link" />
        <child link="RL_wheel" />
        <axis xyz="0 0 -1" />
    </joint>

    <gazebo reference="base_link">
        <mu>0.0</mu>
        <mu2>0.0</mu2>
    </gazebo>
    <gazebo reference="base_footprint">
        <mu>0.0</mu>
        <mu2>0.0</mu2>
    </gazebo>

    <gazebo reference="FL_wheel">
        <mu>${wheel_mu}</mu>
        <mu2>${wheel_mu}</mu2>
        <fdir1>${wheel_fdir1}</fdir1>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
    </gazebo>
    <gazebo reference="FR_wheel">
        <mu>${wheel_mu}</mu>
        <mu2>${wheel_mu}</mu2>
        <fdir1>${wheel_fdir1}</fdir1>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
    </gazebo>
    <gazebo reference="RL_wheel">
        <mu>${wheel_mu}</mu>
        <mu2>${wheel_mu}</mu2>
        <fdir1>${wheel_fdir1}</fdir1>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
    </gazebo>
    <gazebo reference="RR_wheel">
        <mu>${wheel_mu}</mu>
        <mu2>${wheel_mu}</mu2>
        <fdir1>${wheel_fdir1}</fdir1>
        <kp>${wheel_kp}</kp>
        <kd>${wheel_kd}</kd>
    </gazebo>

    <!-- works
    <fdir1>1 0 0</fdir1>
    <fdir1>0 1 0</fdir1> (is janky... odd when stopping after rotating; also drifts backwards on gazebo
    launch)
    <fdir1>1 1 0</fdir1> (is janky... odd when stopping after rotating; also drifts backwards on gazebo
    launch... only very slightly tho) -->
</robot>