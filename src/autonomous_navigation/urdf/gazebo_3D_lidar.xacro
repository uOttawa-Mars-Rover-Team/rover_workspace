<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="lidar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.125" />
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
        </inertial>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.0508" length="0.055" />
            </geometry>
        </collision>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.0508" length="0.055" />
            </geometry>
        </visual>
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="0 0 0.12" rpy="0 0 0" />
    </joint>

    <gazebo reference="lidar_link">
        <sensor name="lidar" type="ray">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>5</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>32</samples> <!-- 32 beam lidar -->
                        <resolution>0.111111</resolution>
                        <min_angle>0.000000</min_angle>
                        <max_angle>6.280000</max_angle> <!-- 2pi rad for full circle scan-->
                    </horizontal>
                    <vertical>
                        <samples>32</samples>
                        <resolution>0.111111</resolution>
                        <min_angle>-1.047198</min_angle> <!-- Start scanning from -pi/3 (down) -->
                        <max_angle>1.047198</max_angle> <!-- End scanning at pi/3 (up) -->
                    </vertical>
                </scan>
                <range> <!-- Range of sensor in metres -->
                    <min>0.1</min>
                    <max>5.0</max>
                    <resolution>0.015000</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>

            <plugin name="3D_scan" filename="libgazebo_ros_ouster_laser.so"> <!-- change -->
                <!-- <ros>
                    <remapping>os1_cloud_node/points:=points</remapping>
                </ros> -->
                <output_type>sensor_msgs/PointCloud2</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>