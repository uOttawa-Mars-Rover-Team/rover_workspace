<!--Launch file for the arm joystick node-->
<launch>
    <!-- Logitech Joystick Node -->
    <node pkg="joy" exec ="joy_node" name="logitech_joy">
        <param name="dev" value="/dev/input/js1" />
        <param name="deadzone" value="0.0" />
        <remap from="joy" to="arm_joy_logitech" />
    </node>

</launch>
  