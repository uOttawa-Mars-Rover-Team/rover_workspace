<!--Launch file for the arm joystick node-->
<launch>
    <!-- Spacemouse Node -->
    <node pkg="joy" exec ="joy_node" name="spacemouse_joy">
        <param name="dev" value="/dev/input/js2" />
        <param name="deadzone" value="0.5" />
        <remap from="joy" to="arm_joy" />
    </node>

</launch>
  