<!--
Launch file for the arm logitech joy node
-->
<launch>
 
    <!--
    Spacemouse by default, so logitech is commented out
    -->

    <!-- Spacemouse Node -->
    <node pkg="joy" exec ="joy_node" name="spacemouse_joy">
        <param name="dev" value="/dev/input/arm_spacemouse" />
        <remap from="joy" to="/joy/arm_ik" />
        <!-- deadzone handled in joy controller node below -->
    </node>

    <!-- Logitech Controller Node -->
    <!-- 
    <node pkg="joy" exec="joy_node" name="logitech_joy">
        <param name="dev" value="/dev/input/js3" />
        <param name="deadzone" value="0.4" />
        <remap from="joy" to="arm_ik_joy" />
    </node>
    -->

    <!--
    WARNING
    Anything below this point should remain unchanged
    WARNING
    -->
        
    <!-- Joy Controller Node -->
    <node pkg="robotic_arm_controls" exec="joy_ik_controller" name="joy_ik_controller_node" output="screen" respawn="false">
        <param name="dev" value="/dev/input/js2" />
        <remap from="joy" to="arm_ik_keyboard_joy" />
        <param name="deadzone" type="float" value="0.4" />
        <param name="pub_rate" type="float" value="20.0" />
    </node>

    <!-- Keyboard Node -->
    <node pkg="robotic_arm_controls" exec="keyboard_ik_controls" name="keyboard_ik_controls_node" output="screen" respawn="false"></node>

    <!-- Define the RViz configuration file path -->
    <arg name="rviz_config_file" default="$(find arm_controls)/config/rviz_config.rviz"/>

    <!-- Launch the RViz node -->
    <node
        pkg="rviz2"
        exec="rviz2"
        name="rviz2"
        output="log"
        args="-d $(arg rviz_config_file)">
        <param name="robot_description" value="$(param robot_description)"/>
        <param name="robot_description_semantic" value="$(param robot_description_semantic)"/>
    </node>

    <!-- Servo Node -->
    <launch>
        <include file="$arm_controls/launch/servo_node.launch.xml"/>
    </launch>

</launch>
