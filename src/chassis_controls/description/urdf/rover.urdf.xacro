<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

    <xacro:arg name="use_gazebo" default="false"/>

    <xacro:property name="testing" value="0"/>
    <xacro:property name="tested_pwm" value="20.0"/>
    <xacro:property name="wheel_diameter" value="0.40601"/>
    <xacro:property name="wheel_max_velocity" value="20.0"/>
    <xacro:property name="wheel_enc_counts_per_rev" value="4096"/>
    <xacro:property name="controller_period" value="0.1"/>
    <xacro:property name="FL_id" value="30"/>
    <xacro:property name="FR_id" value="40"/>
    <xacro:property name="RR_id" value="10"/>
    <xacro:property name="RL_id" value="20"/>

    <xacro:include filename="drive_urdf.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="drive_ros2_control.xacro" />


    <xacro:drive_ros2_control 
        name="DriveSystem"
        use_gazebo="$(arg use_gazebo)"
    />

</robot>
