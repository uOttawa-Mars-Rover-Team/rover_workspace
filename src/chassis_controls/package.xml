<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
	<name>chassis_controls</name>
	<version>1.0.0</version>
	<description>Implements Phoenix API to control drive motors and PDP over CAN</description>
	<maintainer email="luka@todo.todo">luka</maintainer>
	<license>MIT</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<depend>general_interfaces</depend>
	<depend>urdf</depend>
	<depend>rclcpp</depend>
	<depend>rclpy</depend>
	<depend>hardware_interface</depend>
	<depend>pluginlib</depend>
	<depend>rclcpp_lifecycle</depend>
	<depend>ros2_control</depend>
	<depend>diff_drive_controller</depend>
	<depend>moteus_msgs</depend>

	<exec_depend>joint_state_broadcaster</exec_depend>
	<exec_depend>rviz2</exec_depend>
	<exec_depend>joint_state_publisher_gui</exec_depend>
	<exec_depend>geometry_msgs</exec_depend>
	<exec_depend>xacro</exec_depend>
	<exec_depend>twist_mux</exec_depend>
  
	<test_depend>ament_lint_auto</test_depend>
	<test_depend>ament_lint_common</test_depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package>
