<!--
	Use this launch file to run the gps node with the kalman filter.
-->
<launch>
	<!-- The GPS and IMU from the Arduino -->
	<!-- Remove the output=screen to remove the printouts from the gpd node. -->
    <node pkg="gps_node" type="GPS_ros_node.py" name="GPS_ros_node" output="screen">
        <param name="arduino_port" value="/dev/ttyACM0"/>
    </node>

	<!-- The node that takes the GPS data and converts it to something the filter can use -->
	<node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform_node" respawn="true">
		<param name="magnetic_declination_radians" value="0"/>
		<param name="yaw_offset" value="0"/>
		<remap from="/imu/data" to="/imu/sensor/data"/>
		<remap from="/gps/fix" to="/gps/sensor/data"/>
		<remap from="/odometry/filtered" to="odom/filtered"/>
	</node>

	<!-- 
		The first of the two nodes needed for the filter. 
		This one takes all data except the GPS data.
	-->
	<node pkg="robot_localization" type="ekf_localization_node" name="robot_localization_ekf_node_odom" clear_params="true">
		<param name="frequency" value="1"/>
		<param name="sensor_timeout" value="1.5"/>
		<param name="publish_tf" value="true"/>
		<param name="two_d_mode" value="false"/>
		<param name="map_frame" value="map"/>
		<param name="odom_frame" value="odom"/>
		<param name="base_link_frame" value="base_link"/>
		<param name="world_frame" value="odom"/>
		<remap from="/odometry/filtered" to="odom/filtered"/>
		
		<param name="imu0" value="/imu/sensor/data"/>
		<param name="imu0_differential" value="false"/>
		<param name="print_diagnostics" value="true"/>
		<rosparam param="imu0_config">[false, false, false, true, true, true, false, false, false, true, true, true, true, true, true]</rosparam>
	</node>

	<!--
		This is the second of two nodes needed for the filter.
		This one takes all available data (including the GPS).
	-->
	<node pkg="robot_localization" type="ekf_localization_node" name="robot_localization_ekf_node_map" clear_params="true">
		<param name="frequency" value="1"/>
		<param name="sensor_timeout" value="1.5"/>
		<param name="map_frame" value="map"/>
		<param name="odom_frame" value="odom"/>
		<param name="base_link_frame" value="base_link"/>
		<param name="world_frame" value="map"/>
		<remap from="/odometry/filtered" to="map/filtered"/>

		<param name="imu0" value="/imu/sensor/data"/>
		<param name="imu0_differential" value="false"/>
		<param name="print_diagnostics" value="true"/>
		<rosparam param="imu0_config">[false, false, false, true, true, true, false, false, false, true, true, true, true, true, true]</rosparam>
		
		<param name="odom0" value="/odometry/gps"/>
		<rosparam param="odom0_config">[true, true, false, false, false, false, false, false, false, false, false, false, false, false, false]</rosparam>
		<param name="odom0_differential" value="false"/>
	</node>

	<!-- 
		Transform node that gives the reference frame for the IMU. 
		Will need to be updated if the position of the IMU on the rover changes.
	-->
	<node pkg="tf" type="static_transform_publisher" name="link1_broadcaster" args="0 0 0 0 0 0 base_link imu_tf 10" />

	<!-- 
		Transform node that gives the reference frame for the GPS. 
		Will need to be updated if the position of the GPS on the rover changes.
	-->
	<node pkg="tf" type="static_transform_publisher" name="link2_broadcaster" args="0 0 0 0 0 0 base_link gps_tf 10" />
</launch>
