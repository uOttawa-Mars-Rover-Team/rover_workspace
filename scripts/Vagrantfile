Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  
  config.disksize.size = '40GB'

  config.vm.provider "virtualbox" do |vb|
    vb.gui = true
    vb.memory = "8096"
    vb.cpus = 4
    vb.name = "uORover Development VM"


    # Enable ALL USB Controllers
    vb.customize ["modifyvm", :id, "--usb", "on"]
    vb.customize ["modifyvm", :id, "--usbohci", "on"]   # USB 1.1
    vb.customize ["modifyvm", :id, "--usbehci", "on"]   # USB 2.0
    vb.customize ["modifyvm", :id, "--usbxhci", "on"]   # USB 3.0
    
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--graphicscontroller", "vmsvga"]
  end
  
  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y git
    
    useradd -m -s /bin/bash roverdev
    echo "roverdev:password" | chpasswd
    usermod -aG sudo roverdev
    echo "roverdev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/roverdev
    chmod 0440 /etc/sudoers.d/roverdev
  SHELL
  
  # Setup rover workspace (headless, fast)
  config.vm.provision "shell", inline: <<-SHELL
    sudo -u roverdev bash << 'USERSCRIPT'
      cd /home/roverdev
      git clone https://gitlab.com/uorover/rover_workspace.git
      cd rover_workspace
      git checkout ros2-testing
      cd scripts
      ./full_setup.sh
USERSCRIPT
  SHELL
  
  # Install desktop LAST (after everything else works)
  config.vm.provision "shell", inline: <<-SHELL
    DEBIAN_FRONTEND=noninteractive apt-get install -y ubuntu-desktop-minimal
    
    mkdir -p /etc/gdm3
    cat > /etc/gdm3/custom.conf << 'EOF'
[daemon]
AutomaticLoginEnable=true
AutomaticLogin=roverdev
WaylandEnable=false
EOF
  SHELL

  config.vm.provision "shell", inline: <<-SHELL
    echo "Installing Visual Studio Code..."
    
    ARCH=$(dpkg --print-architecture)
    
    if [ "$ARCH" = "arm64" ]; then
      wget -O /tmp/vscode.deb 'https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-arm64'
    else
      wget -O /tmp/vscode.deb 'https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64'
    fi
    
    DEBIAN_FRONTEND=noninteractive apt install -y /tmp/vscode.deb
    
    rm /tmp/vscode.deb
    
    # Install ROS/Python extensions as roverdev user
    sudo -u roverdev code --install-extension ms-python.python
    sudo -u roverdev code --install-extension ms-vscode.cpptools
    sudo -u roverdev code --install-extension twxs.cmake
  SHELL

  # Configure network
  config.vm.provision "shell", inline: <<-SHELL
    echo "=== Boot and network optimizations ==="
    
    # Disable cloud-init network management
    echo "network: {config: disabled}" > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    
    # Configure network properly
    cat > /etc/netplan/01-netcfg.yaml << 'EOF'
network:
  version: 2
  renderer: NetworkManager
  ethernets:
    enp0s3:
      dhcp4: true
      optional: true
EOF
    
    chmod 600 /etc/netplan/01-netcfg.yaml
    rm -f /etc/netplan/50-cloud-init.yaml /etc/netplan/50-vagrant.yaml
    netplan generate
    
    # Disable network wait services (fixes 2min boot delay)
    systemctl disable systemd-networkd-wait-online.service 2>/dev/null || true
    systemctl mask systemd-networkd-wait-online.service
    systemctl disable NetworkManager-wait-online.service 2>/dev/null || true  
    systemctl mask NetworkManager-wait-online.service
  SHELL

  # Disable cloud-init permanently
  config.vm.provision "shell", inline: <<-SHELL
    touch /etc/cloud/cloud-init.disabled
    apt-get purge -y cloud-init
    rm -rf /etc/cloud /var/lib/cloud
  SHELL

  config.vm.provision "shell", inline: <<-SHELL
    echo "=========================================="
    echo "Provisioning complete!"
    echo "VM will shutdown in 5 seconds..."
    echo "Run 'vagrant up' to start the desktop"
    echo "=========================================="
    sleep 5
    shutdown now
  SHELL

end