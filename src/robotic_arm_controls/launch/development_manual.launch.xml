<!--
Launch file for the arm logitech joy node
-->
<launch>

    <!-- Logitech Controller Node -->
    <node pkg="joy" exec="joy_node" name="logitech_joy">
        <param name="dev" value="/dev/input/arm_logitech" />
        <param name="deadzone" value="0.35" />
        <remap from="joy" to="/joy/arm_manual" />
    </node>
 
    <!-- Toggler Node -->
    <node pkg="robotic_arm_controls" exec="toggler" name="toggler_node" output="screen" respawn="false"></node>

	<!-- Router Node -->
	<node pkg="robotic_arm_controls" exec="router" name="router_node" output="screen"
	respawn="true">
		<param name="serial_dev" value="/dev/ttyACM0" />
		<param name="baudrate" type="int" value="115200" />
		<param name="timeout_delay" type="float" value="0.5" />
		<param name="deadband" type="float" value="0.35" />
		<param name="actuator_cap" type="int" value="600" />
	</node>

</launch>
