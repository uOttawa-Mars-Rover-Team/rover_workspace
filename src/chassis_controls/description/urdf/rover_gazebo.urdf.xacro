<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

    <!-- ================= BASE FOOTPRINT & CHASSIS ================= -->
    <link name="base_footprint" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="chassis_link" />
        <origin xyz="0 0 0.15" rpy="0 0 0" />
    </joint>

    <link name="chassis_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.8 0.5 0.2" />
            </geometry>
            <material name="chassis_mat">
                <color rgba="0.2 0.2 0.2 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.8 0.5 0.2" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="15.0" />
            <inertia ixx="0.3625" ixy="0.0" ixz="0.0" iyy="0.85" iyz="0.0" izz="1.1125" />
        </inertial>
    </link>

    <!-- ================= WHEEL MACRO ================= -->
    <xacro:macro name="wheel" params="prefix joint_name x y z">
        <link name="${prefix}_wheel_link">
            <visual>
                <!-- Rotate cylinder 90 deg around X-axis so it aligns as a rolling wheel -->
                <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
                <geometry>
                    <cylinder radius="0.15" length="0.1" />
                </geometry>
                <material name="wheel_mat">
                    <color rgba="0.05 0.05 0.05 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
                <geometry>
                    <cylinder radius="0.15" length="0.1" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="2.5" />
                <inertia ixx="0.0161" ixy="0.0" ixz="0.0" iyy="0.0161" iyz="0.0" izz="0.0281" />
            </inertial>
        </link>

        <joint name="${joint_name}" type="continuous">
            <parent link="chassis_link" />
            <child link="${prefix}_wheel_link" />
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>

    <!-- Instantiate 4 Wheels matching lead specification (q1, q2, q3, q4) -->
    <!-- q1: Front Left | q2: Front Right | q3: Rear Left | q4: Rear Right -->
    <xacro:wheel prefix="front_left" joint_name="q1" x="0.25" y="0.325" z="-0.05" />
    <xacro:wheel prefix="front_right" joint_name="q2" x="0.25" y="-0.325" z="-0.05" />
    <xacro:wheel prefix="rear_left" joint_name="q3" x="-0.25" y="0.325" z="-0.05" />
    <xacro:wheel prefix="rear_right" joint_name="q4" x="-0.25" y="-0.325" z="-0.05" />

    <!-- ================= SENSORS ================= -->

    <!-- IMU -->
    <link name="imu_link" />
    <joint name="imu_joint" type="fixed">
        <parent link="chassis_link" />
        <child link="imu_link" />
        <origin xyz="0 0 0.1" rpy="0 0 0" />
    </joint>

    <!-- 3D LiDAR -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.07" />
            </geometry>
        </visual>
    </link>
    <joint name="lidar_joint" type="fixed">
        <parent link="chassis_link" />
        <child link="lidar_link" />
        <origin xyz="0.3 0 0.15" rpy="0 0 0" />
    </joint>

    <!-- Camera -->
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.04 0.08 0.04" />
            </geometry>
        </visual>
    </link>
    <joint name="camera_joint" type="fixed">
        <parent link="chassis_link" />
        <child link="camera_link" />
        <origin xyz="0.38 0 0.05" rpy="0 0 0" />
    </joint>

    <!-- ================= GAZEBO HARMONIC PLUGINS ================= -->
    <gazebo>
        <!-- 4-Wheel Differential Drive Plugin -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>q1</left_joint>
            <left_joint>q3</left_joint>
            <right_joint>q2</right_joint>
            <right_joint>q4</right_joint>
            <wheel_separation>0.65</wheel_separation>
            <wheel_radius>0.15</wheel_radius>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>

        <!-- Joint State Publisher Plugin -->
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
        </plugin>
    </gazebo>

    <!-- Sensor Gazebo Tags -->
    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <topic>/imu/data</topic>
        </sensor>
    </gazebo>

    <gazebo reference="lidar_link">
        <sensor name="gpu_lidar" type="gpu_lidar">
            <update_rate>10</update_rate>
            <topic>/scan/points</topic>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.261799</min_angle>
                        <max_angle>0.261799</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>30.0</max>
                </range>
            </lidar>
        </sensor>
    </gazebo>

    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <update_rate>30</update_rate>
            <topic>/camera/image_raw</topic>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>