<!--
Use this launch file to run just the gps node.
-->
<launch>
    <!-- Accept `serial_port` as a launch argument passed in from the command line -->
    <arg name="serial_port" default="/dev/ttyACM0" />
    <!-- Allow the gps_node to respawn if it crashes by default -->
    <arg name="respawn" default="true" />

    <!-- Remove the `output=screen` to remove the printouts from the gps node. -->
    <node pkg="gps_node" exec="gps_node" name="gps_node" output="screen"
        respawn="$(var respawn)">
        <param name="serial_port" value="$(var serial_port)" />
    </node>
</launch>