<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover">

    <xacro:arg name="use_gazebo" default="false"/>
    <!-- Unused since the move to moteus: the velocity loop gains now live on
    the controllers. Kept so existing launch commands still work. -->
    <xacro:arg name="sport_mode" default="true"/>

    <!-- moteus r4.11 CAN ids -->
    <xacro:property name="FL_id" value="1"/>
    <xacro:property name="FR_id" value="2"/>
    <xacro:property name="RR_id" value="3"/>
    <xacro:property name="RL_id" value="4"/>

    <!-- Motor revolutions per wheel revolution -->
    <xacro:property name="gear_ratio" value="100.0"/>
    <!-- Largest velocity sent to a moteus [motor rev/s] -->
    <xacro:property name="max_velocity" value="40.0"/>
    <!-- Torque limit sent with every velocity command [Nm] -->
    <xacro:property name="max_torque" value="0.3"/>
    <!-- Extra moteus transport arguments, e.g. "--socketcan-iface can0" or
    "--fdcanusb /dev/ttyACM0". "auto" detects the adapter. -->
    <xacro:property name="transport_args" value="auto"/>

    <xacro:include filename="drive_urdf.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="drive_ros2_control.xacro" />

    <xacro:drive_ros2_control 
        name="DriveSystem"
        use_gazebo="$(arg use_gazebo)"
    />

</robot>
