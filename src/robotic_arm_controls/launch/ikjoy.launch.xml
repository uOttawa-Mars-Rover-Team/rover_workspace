<!--
Launch file for the toggler node
-->
<launch>
    <!-- Toggler Node -->
    <node pkg="robotic_arm_controls" exec="ikjoy" name="ik_joy_node" output="screen" respawn="true">
 
    </node>

    <node pkg="joy" exec="joy_node" name="logitech_joy">
        <param name="dev" value="/dev/input/js1" />
        <param name="deadzone" value="0.35" />
        <remap from="joy" to="arm_joy" />
    </node>
</launch>
